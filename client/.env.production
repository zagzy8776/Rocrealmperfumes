# Production defaults for the deployed frontend.
# Real environment variables set in Vercel override these, so when the custom
# domain goes live just set VITE_SITE_URL in Vercel -> Settings -> Environment
# Variables (Production + Preview) and redeploy - no code change needed.
VITE_SITE_URL="https://rocrealmperfumes.vercel.app"
# Same-origin API: the Express backend runs as a Vercel serverless function (api/index.js).
# To go back to Render instead, set VITE_API_URL="https://rocrealmperfumes.onrender.com/api".
VITE_API_URL="/api"
